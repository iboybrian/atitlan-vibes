<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google sign-in runs in the system browser (Capacitor kicks external
                 navigation out of the WebView). This scheme is how the browser hands
                 the session back — Supabase redirects to com.atitlanvibes://auth and
                 Android routes it here. Must match redirectTo in Auth.jsx and the
                 Redirect URLs allow list in the Supabase dashboard. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.atitlanvibes" />
            </intent-filter>

        </activity>

        <!-- FCM: without this the tray icon renders as a white square on some launchers.
             Swap for a monochrome silhouette drawable if the masked launcher icon looks bad. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required from Android 13 (targetSdk 33+) or the permission dialog never shows -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Coarse only, and only while the app is open (src/lib/geolocation.js).
         ACCESS_BACKGROUND_LOCATION is deliberately absent: it is the one thing
         that triggers Google's Location Permissions declaration — written
         justification plus a demo video plus weeks of review. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Guard, not a request: tools:node="remove" deletes FINE from the merged
         manifest if any library declares it. @capacitor/geolocation 8.2.2 does
         not, so today this is a no-op and the build prints "tagged to remove
         other declarations but no other declaration present" — that warning is
         expected, don't chase it. Keep the line: a plugin version bump that adds
         FINE would otherwise put precise location in the APK silently, and the
         Play Data Safety answers would quietly become false. We never need it —
         the two closest towns are ~4 km apart and coarse is ~1.5 km.
         Verify after a build in
         android/app/build/intermediates/merged_manifests/*/AndroidManifest.xml -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />

    <!-- Location is optional, so don't let Play hide the app from devices without
         the hardware. All three have to be listed: a location permission IMPLIES
         a <uses-feature> that defaults to required="true", and Play then filters
         on it. ACCESS_COARSE_LOCATION implies android.hardware.location and
         .network; ACCESS_FINE_LOCATION would imply .gps. Declaring only .gps
         cost 6 devices on the first upload — Play reports that as "no longer
         supports N devices". The app works fine with no location at all, so
         none of these may ever be required. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
